{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BkmUtilityDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "BaseUrl": "http://localhost:5000",
  "Encryption": {
    "Key": "REPLACE_WITH_32_BYTE_BASE64_KEY=="
  },
  "Logging": {
    "MinimumLevel": "Information",
    "Sinks": {
      "Database": true,
      "File": true
    },
    "File": {
      "Path": "logs/bkm-.txt",
      "FileSizeLimitBytes": 10485760,
      "RetainedFileCountLimit": 30
    },
    "Purge": {
      "InitialDelayMinutes": 5,
      "RunIntervalHours": 24
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "REPLACE_WITH_64_BYTE_BASE64_SECRET_KEY_AT_LEAST_32_CHARS_LONG!",
    "Issuer": "BKM.Utility",
    "Audience": "BKM.Utility.Clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Sso": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Microsoft": {
      "TenantId": "common",
      "ClientId": "",
      "ClientSecret": ""
    }
  }
}
